generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FACULTY
  STUDENT
}

enum AttemptStatus {
  SUCCESS
  ERROR
  RUNNING
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())

  roomsCreated     Room[]            @relation("FacultyRooms")
  memberships      RoomMember[]
  submissions      Submission[]
  practicalRecords PracticalRecord[]
}

model Room {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  faculty      User     @relation("FacultyRooms", fields: [facultyId], references: [id])
  facultyId    String
  allowedHints Int      @default(3)
  createdAt    DateTime @default(now())

  members          RoomMember[]
  problems         Problem[]
  practicalRecords PracticalRecord[]
}

model RoomMember {
  id       String   @id @default(uuid())
  room     Room     @relation(fields: [roomId], references: [id])
  roomId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Problem {
  id          String   @id @default(uuid())
  room        Room     @relation(fields: [roomId], references: [id])
  roomId      String
  title       String
  description String
  starterCode String
  language    Language @default(C)
  createdAt   DateTime @default(now())

  submissions      Submission[]
  practicalRecords PracticalRecord[]
}

model Submission {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  problem    Problem  @relation(fields: [problemId], references: [id])
  problemId  String
  code       String
  status     AttemptStatus
  createdAt  DateTime @default(now())

  attempts Attempt[]
}

model Attempt {
  id              String     @id @default(uuid())
  submission      Submission @relation(fields: [submissionId], references: [id])
  submissionId    String
  compilerRawJson String
  errorCategory   String?
  explanation     String?
  resolved        Boolean    @default(false)
  createdAt       DateTime   @default(now())

  hintUsages HintUsage[]
  aiPatch    AiPatch?
}

model HintUsage {
  id        String   @id @default(uuid())
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  attemptId String
  level     Int
  content   String
  createdAt DateTime @default(now())
}

model AiPatch {
  id         String   @id @default(uuid())
  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  attemptId  String   @unique
  patchDiff  String
  reasoning  String
  createdAt  DateTime @default(now())
}

model PracticalRecord {
  id        String   @id @default(uuid())

  student   User     @relation(fields: [studentId], references: [id])
  studentId String

  problem   Problem  @relation(fields: [problemId], references: [id])
  problemId String

  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String

  code      String
  output    String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, problemId])
  @@index([studentId])
  @@index([roomId])
}